# 复制为 .env 填入实际值
# LLM:本地已有 DeepSeek(参考 ~/.hermes/.env),也兼容 GLM/火山方舟等 OpenAI 兼容端点
LLM_API_KEY=sk-xxx
LLM_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash

# Embedding/Rerank 后端:local=本机模型(默认,离线) / api=SiliconFlow
EMBED_BACKEND=local
EMBED_MODEL=BAAI/bge-small-zh-v1.5
EMBED_DIM=512
RERANK_BACKEND=local
RERANK_MODEL=BAAI/bge-reranker-base

# 若切 api 后端需要填 SiliconFlow key
SILICONFLOW_API_KEY=
SILICONFLOW_API_BASE=https://api.siliconflow.cn/v1

# 若切 zhipu 后端:需智谱开放平台 key 且账号含 embedding-3/rerank 资源包
# (Coding Plan 套餐 key 不含这些资源,会报 1113 余额不足)
ZHIPU_API_KEY=
ZHIPU_API_BASE=https://open.bigmodel.cn/api/paas/v4
ZHIPU_EMBED_MODEL=embedding-3
# zhipu embedding 维度可选 256/512/1024/2048,改维度后须 --force 重建索引
EMBED_DIM=512

# 服务
API_HOST=0.0.0.0
API_PORT=8001
